datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../server/node_modules/.prisma/client"
}

enum Role {
  SUPER_ADMIN
  HR
  TEAM_LEAD
  EMPLOYEE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  REVIEW
  COMPLETED
  REJECTED
  OVERDUE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  HOLIDAY
  WORK_FROM_HOME
  REMOTE
  ON_LEAVE
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  MATERNITY
  PATERNITY
  LOSS_OF_PAY
  EMERGENCY
  HALF_DAY
  COMP_OFF
  MEDICAL
}

enum LeaveStatus {
  PENDING
  MANAGER_APPROVED
  HR_APPROVED
  REJECTED
}

enum RatingTier {
  GOLD
  SILVER
  BRONZE
  NEEDS_IMPROVEMENT
}

enum TimelineEventType {
  JOINED
  PROMOTION
  SALARY_UPDATE
  LEAVE
  WARNING
  PERFORMANCE_REVIEW
  DOCUMENT
  AWARD
  TRAINING_COMPLETED
}

enum DocumentType {
  OFFER_LETTER
  ID_CARD
  EMAIL_SIGNATURE
  EXPERIENCE_LETTER
  APPOINTMENT_LETTER
  RELIEVING_LETTER
  PROMOTION_LETTER
  SALARY_REVISION_LETTER
  WARNING_LETTER
  INTERNSHIP_CERTIFICATE
  COMPLETION_CERTIFICATE
  BONAFIDE_LETTER
}

model User {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  email               String    @unique
  passwordHash        String
  role                Role      @default(EMPLOYEE)
  employeeId          String    @unique
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  refreshToken        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

/// Stores the encrypted OAuth 2.0 tokens for the company Google account that
/// is connected to OneBridge for Google Drive uploads. Tokens are encrypted
/// at rest (AES-256-GCM) with DRIVE_TOKEN_ENCRYPTION_KEY and auto-refreshed.
model GoogleDriveConnection {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  accessToken  String   // encrypted
  refreshToken String   // encrypted
  tokenType    String   @default("Bearer")
  scope        String?
  expiresAt    DateTime
  driveEmail   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Employee {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  employeeId      String           @unique // Unique string like OBI0001
  firstName       String
  lastName        String
  email           String           @unique
  phone           String
  department      String
  designation     String
  bloodGroup      String
  validity        DateTime
  qrCodeUrl       String?
  profileImageUrl String?
  signatureUrl    String?          // Transparent PNG URL (max 2MB)
  customUrl       String?
  customQrUrl     String?
  currentAddress  String?
  permanentAddress String?
  personalInfo    PersonalInfo?
  professionalInfo ProfessionalInfo?
  salaryStructure  SalaryStructure?
  emergencyContact EmergencyContact?
  education       Education[]
  experience      Experience[]
  skills          String[]
  certificates    Certificate[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  attendances     Attendance[]
  leaves          Leave[]
  payrolls        Payroll[]
  tasks           Task[]           @relation("EmployeeTasks")
  assignedTasks   Task[]           @relation("AssignedTasks")
  documents       Document[]
  activityLogs    AuditLog[]
  notifications   Notification[]
  ratings         EmployeeRating[]
  timelineEvents  EmployeeTimeline[]
  offerLetters    OfferLetter[]
  onboardings     Onboarding[]
  hrDocuments     HRDocument[]
  sessionLogs     SessionLog[]
  performanceReviews PerformanceReview[]
  goals              Goal[]         @relation("GoalOwner")
  assignedGoals      Goal[]         @relation("GoalAssigner")
}

type PersonalInfo {
  panCard        String?
  aadharCard     String?
  passportNumber String?
  drivingLicense String?
  dob            DateTime
  gender         String
}

type ProfessionalInfo {
  dateOfJoining    DateTime
  offerLetterUrl   String?
  joiningLetterUrl String?
  resumeUrl        String?
}

type SalaryStructure {
  basic           Float
  hra             Float
  da              Float
  allowance       Float
  bonus           Float
  pf              Float
  esi             Float
  professionalTax Float
  incomeTax       Float
}

type EmergencyContact {
  name         String
  relationship String
  phone        String
  email        String?
}

type Education {
  degree      String
  institution String
  passingYear Int
  percentage  Float?
}

type Experience {
  company     String
  designation String
  years       Float
  description String?
}

type Certificate {
  name          String
  issuedBy      String
  issueDate     DateTime
  expiryDate    DateTime?
  credentialUrl String?
}

model Attendance {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  employeeId      String
  employee        Employee         @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  date            DateTime
  checkIn         DateTime?
  checkOut        DateTime?
  breaks          BreakSession[]
  status          AttendanceStatus @default(ABSENT)
  overtimeMinutes Int              @default(0)
  lateMinutes     Int              @default(0)
  latitude        Float?
  longitude       Float?
  workFromHome    Boolean          @default(false)
  createdAt       DateTime         @default(now())
}

type BreakSession {
  start DateTime
  end   DateTime?
}

model Leave {
  id                String      @id @default(auto()) @map("_id") @db.ObjectId
  employeeId        String
  employee          Employee    @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  leaveType         LeaveType
  startDate         DateTime
  endDate           DateTime
  isHalfDay         Boolean     @default(false)
  halfDayPeriod     String?     // MORNING, AFTERNOON
  isEmergency       Boolean     @default(false)
  reason            String
  attachments       String[]
  status            LeaveStatus @default(PENDING)
  managerApprovalId String?
  hrApprovalId      String?
  managerComment    String?
  hrComment         String?
  createdAt         DateTime    @default(now())
}

model Task {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  description    String
  projectName    String?
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(PENDING)
  startDate      DateTime?
  dueDate        DateTime
  expectedHours  Float?
  progress       Int          @default(0)
  riskLevel      String?      // LOW, MEDIUM, HIGH
  attachments    String[]
  employeeId     String
  employee       Employee     @relation("EmployeeTasks", fields: [employeeId], references: [employeeId], onDelete: Cascade)
  assignedById   String
  assignedBy     Employee     @relation("AssignedTasks", fields: [assignedById], references: [employeeId], onDelete: Cascade)
  comments       Comment[]
  timeLogs       TimeLog[]
  subtasks       SubTask[]
  dependencies   String[]
  isRecurring    Boolean      @default(false)
  recurrenceCron String?
  emailSent      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

type Comment {
  authorId   String
  authorName String
  content    String
  attachments String[]
  timestamp  DateTime @default(now())
}

type TimeLog {
  employeeId      String
  durationMinutes Int
  loggedAt        DateTime @default(now())
}

type SubTask {
  title       String
  isCompleted Boolean @default(false)
}

model Payroll {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  month           Int
  financialYear   String
  payslipNumber   String   @unique
  basic           Float
  hra             Float
  da              Float
  allowance       Float
  bonus           Float
  pf              Float
  esi             Float
  professionalTax Float
  incomeTax       Float
  netSalary       Float
  payslipPdfUrl   String?
  status          String   @default("GENERATED")
  createdAt       DateTime @default(now())
}

model Document {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  name       String
  category   String
  fileUrl    String
  uploadedAt DateTime @default(now())
}

model AuditLog {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [employeeId], onDelete: SetNull)
  action     String
  details    String
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime  @default(now())
}

model Notification {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  title      String
  message    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model AttendanceCode {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  code      String   @unique
  date      DateTime
  createdBy String
  isActive  Boolean  @default(true)
  usedBy    String[]
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([date, isActive])
}

model EmployeeRating {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  employeeId       String
  employee         Employee    @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  period           String      // "2026-08" for monthly, "2026-Q3" for quarterly, "2026" for yearly
  periodType       String      // MONTHLY, QUARTERLY, YEARLY
  attendanceScore  Float       @default(0)  // 35 pts max
  taskScore        Float       @default(0)  // 40 pts max
  deadlineAccuracy Float       @default(0)  // 10 pts max
  leaveBalanceScore Float      @default(0)  // 10 pts max
  behaviorBonus    Float       @default(0)  // 5 pts max
  overallScore     Float       @default(0)  // 100 pts max
  tier             RatingTier  @default(NEEDS_IMPROVEMENT)
  rank             Int?
  achievements     String[]
  managerFeedback  Float?      // 0-10
  peerFeedback     Float?      // 0-10
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([employeeId, period, periodType])
  @@index([period, periodType, overallScore])
}

model EmployeeTimeline {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  employeeId  String
  employee    Employee          @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  eventType   TimelineEventType
  title       String
  description String?
  date        DateTime
  metadata    Json?
  createdBy   String?
  createdAt   DateTime          @default(now())

  @@index([employeeId, date])
}

model OfferLetter {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId      String?
  candidateName   String
  candidateEmail  String
  role            String
  department      String
  salary          Float
  joiningDate     DateTime
  reportingManager String?
  officeAddress   String?
  probationMonths Int      @default(6)
  noticePeriodDays Int     @default(90)
  benefits        String[]
  htmlContent     String?
  status          String   @default("DRAFT") // DRAFT, REVIEW, APPROVED, SENT, ACCEPTED, REJECTED
  version         Int      @default(1)
  docxFileUrl     String?
  pdfFileUrl      String?
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employee        Employee? @relation(fields: [employeeId], references: [employeeId], onDelete: SetNull)
  onboarding      Onboarding?
  @@index([candidateEmail, status])
}

enum OnboardingStatus {
  OFFER_SENT
  ACCEPTED
  DOCUMENTS_PENDING
  DOCUMENTS_SUBMITTED
  HR_VERIFICATION
  DOCUMENTS_VERIFIED
  APPROVED
  JOINING_LETTER_SENT
  READY_TO_JOIN
  JOINED
  EMPLOYEE_CREATED
  CREDENTIALS_SENT
  ACTIVE
  COMPLETED
  REJECTED
  CHANGES_REQUESTED
  EXPIRED
}

model Onboarding {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  offerLetterId   String    @unique @db.ObjectId
  offerLetter     OfferLetter @relation(fields: [offerLetterId], references: [id], onDelete: Cascade)
  employeeId      String?
  employee        Employee? @relation(fields: [employeeId], references: [employeeId], onDelete: SetNull)

  token           String    @unique
  tokenExpiresAt  DateTime

  candidateId     String?   // EMP-XXXX reference id assigned at offer time
  driveFolderId   String?   // Google Drive folder id for the candidate
  driveFolderPath String?   // Google Drive folder path

  status          OnboardingStatus @default(OFFER_SENT)

  candidateData   Json?    // personal info, addresses, gov ids, emergency, education, bank details
  companyAssets   Json?    // companyLogoDataUrl, authorizedSignatureDataUrl, companySealDataUrl
  signatureType   String?  // DRAW | UPLOAD | TYPE
  signatureData   String?  // base64 PNG data url (draw/upload) or rendered typed signature
  signatureText   String?  // typed signature text

  signedOfferFileId String?
  signedOfferUrl    String?
  joiningLetterFileId String?
  joiningLetterUrl   String?

  acceptedAt        DateTime?
  joinedAt          DateTime?
  credentialsSentAt DateTime?
  completedAt       DateTime?
  verificationBy    String?
  verificationAt    DateTime?
  verificationNote  String?
  reviewReason      String? // reason for rejection / change request

  documents         OnboardingDocument[]
  auditTrail        OnboardingAuditLog[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
}

model OnboardingDocument {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  onboardingId String     @db.ObjectId
  onboarding   Onboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  type         String     // OFFER_LETTER, AADHAAR, PAN, RESUME, CERTIFICATES, PASSPORT_PHOTO, SIGNATURE, JOINING_LETTER
  fileName     String
  mimeType     String
  size         Int
  driveFileId  String?
  driveUrl     String?
  localUrl     String?
  uploadedAt   DateTime   @default(now())

  @@index([onboardingId, type])
}

model OnboardingAuditLog {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  onboardingId String     @db.ObjectId
  onboarding   Onboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  action       String
  details      String
  actorId      String?
  actorType    String     @default("SYSTEM") // HR | CANDIDATE | SYSTEM
  timestamp    DateTime   @default(now())

  @@index([onboardingId, timestamp])
}

model Holiday {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  date        DateTime
  type        String   @default("PUBLIC") // PUBLIC, RESTRICTED, COMPANY_SPECIFIC
  description String?
  createdAt   DateTime @default(now())

  @@unique([date])
}

model FinanceTransaction {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  type        String   // REVENUE, EXPENSE
  category    String   // SALARY, OFFICE_EXPENSE, SOFTWARE, MARKETING, TRAINING, RECRUITMENT, VENDOR, TAX, OTHER
  amount      Float
  description String
  date        DateTime
  reference   String?
  paidBy      String?
  status      String   @default("COMPLETED") // PENDING, COMPLETED, OVERDUE
  department  String?
  employeeId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type, date, category])
}

model HRDocument {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  employeeId      String?
  documentType    DocumentType
  title           String
  fileUrl         String?
  content         Json?
  version         Int          @default(1)
  status          String       @default("DRAFT")
  generatedBy     String?
  issuedDate      DateTime?
  validUntil      DateTime?
  qrCodeUrl       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  employee        Employee?    @relation(fields: [employeeId], references: [employeeId], onDelete: SetNull)
  @@index([documentType, employeeId])
}

model SessionLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  loginTime    DateTime
  logoutTime   DateTime?
  ipAddress    String?
  userAgent    String?
  device       String?
  browser      String?
  sessionToken String?
  createdAt    DateTime @default(now())

  @@index([employeeId, loginTime])
}

model PerformanceReview {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  reviewerId     String?
  reviewPeriod   String
  rating         Float
  strengths      String[]
  improvements   String[]
  goals          String[]
  managerComment String?
  employeeComment String?
  status         String   @default("DRAFT")
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([employeeId, reviewPeriod])
}

enum GoalStatus {
  NOT_STARTED
  ON_TRACK
  BEHIND
  AT_RISK
  BLOCKED
  COMPLETED
  CANCELLED
}

enum GoalPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Embedded OKR item on a Goal
type GoalKeyResult {
  id         String
  title      String
  current    Float    @default(0)
  target     Float
  unit       String?
  progress   Int      @default(0)
  confidence Int?
}

type GoalCheckIn {
  id             String
  authorId       String?
  authorName     String
  weekLabel      String
  progress       Int
  problems       String?
  wins           String?
  nextActions    String?
  attachments    String[]
  managerComment String?
  status         String?
  createdAt      DateTime @default(now())
}

type GoalComment {
  id          String
  authorId    String?
  authorName  String
  content     String
  isManager   Boolean  @default(false)
  attachments String[]
  timestamp   DateTime @default(now())
}

type GoalActivity {
  id        String
  actorId   String?
  actorName String
  type      String
  message   String
  metadata  Json?
  timestamp DateTime @default(now())
}

/// Enterprise Goals / OKR engine feeding reviews, promotions & compensation
model Goal {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  title             String
  description       String
  goalType          String         @default("INDIVIDUAL") // COMPANY, DEPARTMENT, TEAM, INDIVIDUAL, LEARNING, INNOVATION, REVENUE, CUSTOMER_SUCCESS, QUALITY, PROJECT, LEADERSHIP, STRETCH
  ownerId           String
  owner             Employee       @relation("GoalOwner", fields: [ownerId], references: [employeeId], onDelete: Cascade)
  assignedById      String?
  assignedBy        Employee?      @relation("GoalAssigner", fields: [assignedById], references: [employeeId], onDelete: SetNull)
  managerName       String?
  managerId         String?
  department        String
  priority          GoalPriority   @default(MEDIUM)
  weight            Float          @default(1)
  progress          Int            @default(0)
  status            GoalStatus     @default(NOT_STARTED)
  confidence        Int?
  startDate         DateTime       @default(now())
  endDate           DateTime?
  dueDate           DateTime?
  businessObjective String?
  businessImpact    String?
  successMetrics    String[]
  kpiName           String?
  kpiCurrent        Float?
  kpiTarget         Float?
  kpiUnit           String?
  departmentKpi     String?        // SALES, MARKETING, ENGINEERING, FINANCE, HR, OPERATIONS
  linkedProject     String?
  linkedKpiIds      String[]
  skills            String[]
  contributors      String[]
  attachments       String[]
  keyResults        GoalKeyResult[]
  checkIns          GoalCheckIn[]
  comments          GoalComment[]
  activities        GoalActivity[]
  dependencies      String[]
  parentGoalId      String?
  isCompanyGoal     Boolean        @default(false)
  visibility        String         @default("TEAM") // PRIVATE, TEAM, DEPARTMENT, COMPANY
  approvalStatus    String         @default("APPROVED") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED
  approvalNote      String?
  points            Int            @default(0)
  aiNotes           Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([ownerId, status])
  @@index([department, status])
  @@index([status, dueDate])
}

/// Reusable goal templates for the Admin Panel
model GoalTemplate {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  goalType       String
  description    String
  keyResults     Json
  successMetrics Json
  skills         String[]
  aiConfig       Json?
  isActive       Boolean  @default(true)
  usageCount     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([goalType, isActive])
}

enum LeadStatus {
  NEW
  CONTACTED
  PROPOSAL_REQUESTED
  PROPOSAL_SENT
  PROPOSAL_ACCEPTED
  DEMO_SCHEDULED
  DEMO_COMPLETED
  NEGOTIATING
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  CONVERTED
  DECLINED
  EXPIRED
}

enum InvoicePaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum VoucherType {
  PAYMENT
  RECEIPT
  JOURNAL
  CONTRA
  SALES
  PURCHASE
}

enum AccountGroup {
  ASSET
  LIABILITY
  INCOME
  EXPENSE
  EQUITY
}

model Lead {
  id                String      @id @default(auto()) @map("_id") @db.ObjectId
  leadNumber        String      @unique
  clientName        String
  companyName       String?
  email             String
  phone             String
  serviceOfInterest String?     // Cloud Solutions, AI & Automation, DevOps & CI/CD, Cybersecurity, Software Development, Staffing, Digital Transformation, AI Agents, Marketing Cloud, Other
  projectDetails    String?     // Challenge, goals, scope from contact form
  timeline          String?     // Immediate, 1-3 Months, 3-6 Months, Flexible
  source            String      @default("WEBSITE") // WEBSITE, REFERRAL, LINKEDIN, COLD_CALL, CAMPAIGN, OTHER
  status            LeadStatus  @default(NEW)
  estimatedValue    Float       @default(0)
  currency          String      @default("INR")
  notes             String?
  assignedTo        String?     // employeeId or Super Admin
  followUpDate      DateTime?
  quotations        Quotation[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status, email])
}

model Quotation {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  quotationNumber   String          @unique // e.g. QUO-2026-0001
  leadId            String?         @db.ObjectId
  lead              Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  companyId         String?         @db.ObjectId // Issuing company; falls back to the default BillingCompany
  company           BillingCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  clientId          String?         @db.ObjectId
  client            BillingClient?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  poNumber          String?
  bankAccountId     String? // Which company bank account to print; "NONE" hides bank details
  title             String? // Heading printed on the quotation, e.g. "Website Development Proposal"
  placeOfSupply     String? // State name used for GST (defaults from client GSTIN)
  placeOfSupplyCode String? // 2-digit GST state code
  taxType           String? // CGST_SGST or IGST
  cgstAmount        Float           @default(0)
  sgstAmount        Float           @default(0)
  igstAmount        Float           @default(0)
  additionalCharges Float           @default(0)
  additionalChargesLabel String?
  amountInWords     String?
  shareToken        String? // Random token for the client's public view link
  viewedAt          DateTime?
  viewCount         Int             @default(0)
  acceptedAt        DateTime?
  acceptedBy        String? // Name typed by the client (or admin) when accepting
  clientName        String
  clientCompany     String?
  clientEmail       String
  clientPhone       String?
  clientAddress     String?
  clientGst         String?
  items             Json            // Array of { description, quantity, unitPrice, taxPercent, amount }
  subTotal          Float
  taxPercent        Float           @default(18)
  taxAmount         Float           @default(0)
  discountAmount    Float           @default(0)
  totalAmount       Float
  currency          String          @default("INR")
  termsAndConditions String?
  notes             String?
  status            QuotationStatus @default(DRAFT)
  validUntil        DateTime?
  pdfUrl            String?
  sentViaEmail      Boolean         @default(false)
  sentViaWhatsApp   Boolean         @default(false)
  lastSentAt        DateTime?
  invoices          Invoice[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([status, clientEmail])
  @@index([shareToken])
}

model Invoice {
  id                 String               @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNumber      String               @unique // e.g. INV-2026-0001
  quotationId        String?              @db.ObjectId
  quotation          Quotation?           @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  companyId          String?              @db.ObjectId // Issuing company; falls back to the default BillingCompany
  company            BillingCompany?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  clientId           String?              @db.ObjectId
  client             BillingClient?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  poNumber           String?
  bankAccountId      String? // Which company bank account to print; "NONE" hides bank details
  placeOfSupply     String? // State name used for GST (defaults from client GSTIN)
  placeOfSupplyCode String? // 2-digit GST state code
  taxType           String? // CGST_SGST or IGST
  cgstAmount        Float                @default(0)
  sgstAmount        Float                @default(0)
  igstAmount        Float                @default(0)
  additionalCharges Float                @default(0)
  additionalChargesLabel String?
  amountInWords     String?
  shareToken        String? // Random token for the client's public view link
  viewedAt          DateTime?
  viewCount         Int                  @default(0)
  isDraft            Boolean              @default(false)
  payments           Json? // Array of { amount, method, reference, date, notes, recordedAt }
  clientName         String
  clientCompany      String?
  clientEmail        String
  clientPhone        String?
  clientGst          String?
  billingAddress     String?
  items              Json                 // Array of { description, quantity, unitPrice, taxPercent, amount }
  subTotal           Float
  taxPercent         Float                @default(18)
  taxAmount          Float                @default(0)
  discountAmount     Float                @default(0)
  totalAmount        Float
  amountPaid         Float                @default(0)
  balanceDue         Float                @default(0)
  currency           String               @default("INR")
  issueDate          DateTime             @default(now())
  dueDate            DateTime
  paymentStatus      InvoicePaymentStatus @default(UNPAID)
  paymentMethod      String?              // BANK_TRANSFER, UPI, CHEQUE, CASH, CARD
  paymentReference   String?              // UTR / Transaction ID
  paymentQrCodeUrl   String?
  pdfUrl             String?
  notes              String?
  termsAndConditions String?
  sentViaEmail       Boolean              @default(false)
  sentViaWhatsApp    Boolean              @default(false)
  lastReminderSentAt DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([paymentStatus, clientEmail, issueDate])
  @@index([shareToken])
}

// Company that issues quotations/invoices ("Billed By"). One is marked default.
model BillingCompany {
  id                String      @id @default(auto()) @map("_id") @db.ObjectId
  name              String      // Legal name printed on documents
  gstin             String?
  pan               String?
  email             String?
  phone             String?
  website           String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?     // Used to decide CGST+SGST vs IGST
  stateCode         String?     // GST state code, e.g. "36" for Telangana
  pincode           String?
  country           String      @default("India")
  logoDataUrl       String?     // Images stored inline (data URL) so they survive redeploys
  signatureDataUrl  String?
  stampDataUrl      String?
  bankAccountName   String?
  bankName          String?
  bankAccountNumber String?
  bankIfsc          String?
  bankBranch        String?
  bankSwift         String?
  upiId             String?
  // Array of { id, label, accountName, bankName, accountNumber, ifsc, branch, swift, isDefault }.
  // The flat bank* fields above mirror the default account (used as a fallback).
  bankAccounts      Json?
  quotationTerms    String?
  invoiceTerms      String?
  defaultNotes      String?
  emailCc           String?     // Comma-separated, CC'd on every document email
  isDefault         Boolean     @default(false)
  isActive          Boolean     @default(true)
  quotations        Quotation[]
  invoices          Invoice[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

// Saved customer for the "Billed To" picker.
model BillingClient {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  company        String?
  email          String?
  phone          String?
  gstin          String?
  billingAddress String?
  state          String?
  stateCode      String?
  leadId         String?     @db.ObjectId
  quotations     Quotation[]
  invoices       Invoice[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([name])
}

// Atomic sequence per document type and year, e.g. key "INV-2026".
model DocumentCounter {
  id  String @id @default(auto()) @map("_id") @db.ObjectId
  key String @unique
  seq Int    @default(0)
}

model FinanceLedger {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  code           String       @unique // e.g. ACC-1001
  name           String       // e.g. HDFC Bank, Client Receivables, Salary Exp, Office Rent
  group          AccountGroup // ASSET, LIABILITY, INCOME, EXPENSE, EQUITY
  openingBalance Float        @default(0)
  currentBalance Float        @default(0)
  description    String?
  isSystem       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  debitVouchers  FinanceVoucher[] @relation("DebitLedger")
  creditVouchers FinanceVoucher[] @relation("CreditLedger")

  @@index([group])
}

model FinanceVoucher {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  voucherNumber  String       @unique // e.g. VCH-2026-0001
  voucherType    VoucherType  @default(PAYMENT) // PAYMENT, RECEIPT, JOURNAL, CONTRA, SALES, PURCHASE
  date           DateTime     @default(now())
  debitLedgerId  String       @db.ObjectId
  debitLedger    FinanceLedger @relation("DebitLedger", fields: [debitLedgerId], references: [id], onDelete: Cascade)
  creditLedgerId String       @db.ObjectId
  creditLedger   FinanceLedger @relation("CreditLedger", fields: [creditLedgerId], references: [id], onDelete: Cascade)
  amount         Float
  narration      String
  referenceNo    String?      // Cheque/UTR/Invoice No
  invoiceId      String?      // linked invoice if any
  documentUrl    String?      // attached receipt / bill
  isGstApplicable Boolean     @default(false)
  gstRate        Float?       @default(18)
  gstType        String?      // CGST_SGST, IGST
  gstAmount      Float?       @default(0)
  verifiedByCA   Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([voucherType, date])
}

model AutomationTemplate {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  channel      String   // EMAIL, WHATSAPP
  triggerEvent String   // QUOTATION_CREATED, INVOICE_SENT, PAYMENT_REMINDER, PAYMENT_RECEIVED, WELCOME_LEAD
  subject      String?  // For Email
  content      String   // Markdown / HTML or WhatsApp text with {{clientName}}, {{invoiceNumber}}, etc.
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([triggerEvent, channel])
}

model CommunicationLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  channel     String   // EMAIL, WHATSAPP
  recipient   String   // Email or Phone Number
  recipientName String?
  subject     String?
  messageBody String
  status      String   @default("SENT") // SENT, DELIVERED, FAILED, QUEUED
  errorMessage String?
  referenceId String?  // quotationId or invoiceId
  metadata    Json?
  sentAt      DateTime @default(now())

  @@index([channel, sentAt])
}

model ParsedStatementLog {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  originalFileName      String
  fileUrl               String
  fileType              String   @default("BANK_STATEMENT") // BANK_STATEMENT, INVOICE_PDF, EXPENSE_RECEIPT
  extractedData         Json     // parsed summary and line items
  status                String   @default("PENDING_REVIEW") // PENDING_REVIEW, PROCESSED, REJECTED
  totalAmountParsed     Float    @default(0)
  totalItemsCount       Int      @default(0)
  generatedInvoiceIds   String[] // generated invoices if any
  generatedVoucherIds   String[] // generated finance vouchers if any
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// -------------------------------------------------------------
// AI-FIRST AUTONOMOUS BUSINESS OPERATING SYSTEM (BOS)
// -------------------------------------------------------------

enum AiAgentRole {
  LEAD_QUALIFIER       // Ava: Lead qualification & enrichment
  SOLUTION_ARCHITECT   // Scott: BRD, SRS, Technical architecture & scope
  PROPOSAL_ENGINEER    // Paige: Multi-tier proposals & pricing
  NEGOTIATION_AGENT    // Neo: Concession matrix & trade-offs
  FINANCE_OFFICER      // Fiona: Auto-invoicing, payments, & double-entry ledgers
  FOLLOWUP_MANAGER     // Chase: Omnichannel cadence nurturing
  EXECUTIVE_ANALYST    // Orion: CEO forecasting & risk intelligence
}

enum AiAutonomyMode {
  FULLY_AUTONOMOUS     // AI acts automatically with no human intervention
  SUPERVISED           // High-confidence acts automatically, low-confidence seeks approval
  MANUAL_APPROVAL_ONLY // All actions queued for human signoff
}

model AiAgentConfig {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  agentRole         AiAgentRole    @unique
  name              String         // Ava, Scott, Paige, Neo, Fiona, Chase, Orion
  title             String         // "AI Senior Solution Architect", etc.
  avatar            String?
  autonomyMode      AiAutonomyMode @default(SUPERVISED)
  minConfidence     Float          @default(0.85) // Threshold for fully autonomous execution
  maxAutonomousVal  Float          @default(500000) // Deals/invoices above this require supervisor review
  isActive          Boolean        @default(true)
  totalActionsTaken Int            @default(0)
  totalSuccessCount Int            @default(0)
  averageLatencyMs  Int            @default(450)
  systemPrompt      String?
  capabilities      String[]
  metadata          Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model AiDecisionLog {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  agentRole       AiAgentRole
  agentName       String
  eventType       String       // lead.created, discovery.requested, quote.generate, etc.
  entityId        String?      // leadId, quotationId, invoiceId, etc.
  entityType      String?      // LEAD, QUOTATION, INVOICE, VOUCHER, CLIENT
  confidence      Float        // 0.00 to 1.00
  reasoningChain  String       // Explanation of decision
  actionTaken     String       // What the agent executed
  inputPayload    Json?
  outputPayload   Json?
  status          String       @default("EXECUTED") // EXECUTED, ESCALATED_FOR_REVIEW, APPROVED_BY_HUMAN, REJECTED
  reviewedBy      String?      // Supervisor ID
  reviewedAt      DateTime?
  reviewComments  String?
  executionTimeMs Int          @default(0)
  createdAt       DateTime     @default(now())

  @@index([agentRole, eventType, createdAt])
  @@index([status, entityId])
}

model AiDiscoveryDocument {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  leadId             String    @db.ObjectId
  leadNumber         String
  clientName         String
  serviceCategory    String
  executiveSummary   String
  businessObjectives String[]
  technicalScope     Json      // Components, Stack, Cloud Architecture, Integrations
  functionalReqs     String[]  // Key functional requirements (SRS)
  nonFunctionalReqs  String[]  // Security, Scalability, Compliance, SLA
  milestones         Json      // Phases: Discovery, Design, Dev, QA, Deploy with weeks
  teamComposition    Json      // Architects, Engineers, QA, PM with FTE %
  riskMatrix         Json      // Risk, Impact, Mitigation Strategy
  estimatedTimeline  String    // e.g. "8-10 Weeks"
  recommendedStack   String[]
  architectureDiagram String?  // Mermaid diagram code or image URL
  confidenceScore    Float     @default(0.92)
  version            Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([leadId, leadNumber])
}

model AiNegotiationLog {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  quotationId       String   @db.ObjectId
  quotationNumber   String
  clientFeedback    String   // e.g. "Budget is 15% lower than quote"
  objectionCategory String   // PRICING, TIMELINE, SCOPE, PAYMENT_TERMS
  originalAmount    Float
  proposedAmount    Float
  counterOfferScope Json     // Scope adjustments, payment term alterations
  marginPreserved   Float    // Gross profit margin %
  concessionPolicy  String   // STRICT_MARGIN, VOLUME_DISCOUNT, MVP_PHASING
  status            String   @default("COUNTER_OFFER_DISPATCHED") // COUNTER_OFFER_DISPATCHED, ACCEPTED, ESCALATED
  createdAt         DateTime @default(now())

  @@index([quotationId, quotationNumber])
}

model AutonomousFollowupTask {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  leadId           String    @db.ObjectId
  channel          String    // EMAIL, WHATSAPP, SMS
  cadenceDay       Int       // Day 1, Day 2, Day 5, Day 8, Day 12, Day 20
  scheduledFor     DateTime
  templateSubject  String?
  templateBody     String
  status           String    @default("PENDING") // PENDING, EXECUTED, CANCELLED_CLIENT_REPLIED, FAILED
  executedAt       DateTime?
  cancellationNote String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([scheduledFor, status])
  @@index([leadId, status])
}


